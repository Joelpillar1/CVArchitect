VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================
# Creem Payments — set these as Supabase Edge Function secrets
# Dashboard: Project Settings → Edge Functions → Secrets
# Or CLI: supabase secrets set CREEM_API_KEY=...
# ============================================================
CREEM_API_KEY=creem_test_xxxxxxxxxxxxxxxx
CREEM_ENVIRONMENT=test                   # 'test' for test mode or 'production' for live
CREEM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# Product IDs from Creem dashboard:
CREEM_BUILD_PRODUCT_ID=prod_xxx          # Build — monthly $10
CREEM_LIFETIME_PRODUCT_ID=prod_xxx       # Lifetime — one-time $99

# Creem Webhook URL (register in Creem dashboard → Developers → Webhooks):
# https://<project-ref>.supabase.co/functions/v1/creem-webhook

# App URL — used for OAuth redirects in production; browser uses window.location in dev
VITE_APP_URL=http://localhost:5173
APP_URL=https://cvarchitect.app

# Supabase auto-injects these for Edge Functions; set for local/Vercel fallback:
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# CVArchitect Agent (/resume-agent) — Vercel Node function api/agent/run.ts
# Server-side only; NEVER prefixed VITE_ (must not reach the browser bundle).
# Set in the Vercel dashboard for prod, and in local .env to run `vercel dev`.
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above for its auth check.
# ============================================================
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini   # optional; default. Stay on the GPT-4o family.

# Resend Email (server-side only)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=CVArchitect <support@cvarchitect.app>

# Loops.so (server-side only)
LOOPS_API_KEY=loops_xxxxxxxxxxxxxxxxxxxxxxxx

# Dodo webhook URL (register in Dodo dashboard):
# https://<project-ref>.supabase.co/functions/v1/dodo-webhook
